PORT=3334
NODE_ENV=production

# Database (same PostgreSQL as AutomaBotHub API)
DATABASE_URL=postgres://user:password@postgres-main:5432/automabothub

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# AI — Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-001

# AI — Ollama (fallback)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CHAT_MODEL=qwen3:0.6b

# Threat Intelligence (optional — free tiers)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Email notifications
RESEND_API_KEY=

# Abuse Detection
ABUSE_CONFIDENCE_THRESHOLD=70

# Health — Uptime Kuma push monitor
UPTIME_KUMA_PUSH_URL=

# Host Security SSH (legacy default — prefer /add-server via Telegram)
HOST_SSH_HOST=127.0.0.1
HOST_SSH_PORT=49222
HOST_SSH_USER=ubuntu
HOST_SSH_KEY_PATH=/home/node/.ssh/id_ed25519

# Docker Compose — path to SSH keys dir (mounted as /home/node/.ssh)
SSH_KEY_DIR=~/.ssh
