# ─── Guardian Blue Team — Environment Configuration ─────────────────────────
# Copy this file to .env and fill in your values.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3334
NODE_ENV=production

# ─── Database (Guardian's own PostgreSQL) ────────────────────────────────────
# Points to the guardian-db container by default.
DATABASE_URL=postgres://guardian:guardian_secret@guardian-db:5432/guardian

# ─── AutomaBotHub Integration (optional) ─────────────────────────────────────
# Set to false for standalone mode (no n8n abuse detection).
AUTOMABOTHUB_ENABLED=false
# If enabled, provide the AutomaBotHub database URL:
# AUTOMABOTHUB_DATABASE_URL=postgres://guardian_reader:password@autohub-db:5432/automabothub

# ─── Docker ──────────────────────────────────────────────────────────────────
# Only needed if running outside the guardian container.
# DOCKER_HOST=unix:///var/run/docker.sock

# ─── Telegram Bot ────────────────────────────────────────────────────────────
# Create a bot via @BotFather and get the token.
TELEGRAM_BOT_TOKEN=
# Get your chat ID via @userinfobot or forwarding a message to @raw_data_bot.
TELEGRAM_CHAT_ID=
# Optional: secret header for webhook validation.
# TELEGRAM_WEBHOOK_SECRET=

# ─── AI — Gemini (primary, for threat analysis) ──────────────────────────────
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-001

# ─── AI — Ollama (local fallback) ────────────────────────────────────────────
# Only used if Gemini is unavailable. Point to your Ollama instance.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CHAT_MODEL=qwen3:0.6b

# ─── Threat Intelligence ─────────────────────────────────────────────────────
# AbuseIPDB — free tier: 1000 lookups/day. https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=
# VirusTotal — free tier: 500 lookups/day. https://www.virustotal.com/
# VIRUSTOTAL_API_KEY=

# ─── Email Notifications (optional) ──────────────────────────────────────────
# Resend API for email alerts. https://resend.com/
# RESEND_API_KEY=

# ─── Abuse Detection Tuning ──────────────────────────────────────────────────
# Minimum AI confidence (0-100) to propose an action. Lower = more sensitive.
ABUSE_CONFIDENCE_THRESHOLD=70

# ─── Health Monitoring ───────────────────────────────────────────────────────
# Uptime Kuma push URL for heartbeat monitoring.
# UPTIME_KUMA_PUSH_URL=https://uptime.example.com/api/push/xxxxx

# ─── CVE Monitor ────────────────────────────────────────────────────────────
# Monitors OSV.dev for CVEs affecting installed packages on your servers.
CVE_MONITOR_ENABLED=true
# Minimum CVSS score (0-10) to trigger notification. Default 7.0 (High+Critical).
CVE_MONITOR_MIN_CVSS=7.0
# How often to check for new CVEs (in hours). Default 6.
CVE_MONITOR_INTERVAL_HOURS=6

# ─── SSH Defaults (legacy — prefer /add-server via Telegram) ─────────────────
HOST_SSH_HOST=127.0.0.1
HOST_SSH_PORT=49222
HOST_SSH_USER=ubuntu
HOST_SSH_KEY_PATH=/home/node/.ssh/id_ed25519

# ─── Docker Compose Variables ─────────────────────────────────────────────────
# Path to SSH keys directory (mounted read-only into container).
SSH_KEY_DIR=~/.ssh
# Domain for Traefik routing.
GUARDIAN_DOMAIN=guardian.example.com
# Password for the guardian-db PostgreSQL container.
GUARDIAN_DB_PASSWORD=guardian_secret
