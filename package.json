{
  "name": "guardian-blue-team",
  "version": "3.1.1",
  "description": "Lightweight SOAR for the rest of us — server security monitoring with automated response",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/afborda/guardian-blue-team.git"
  },
  "homepage": "https://github.com/afborda/guardian-blue-team",
  "keywords": [
    "siem",
    "soar",
    "security",
    "monitoring",
    "ssh",
    "threat-detection",
    "cve",
    "homelab"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsx scripts/generate-allowlist.ts && tsup",
    "build:allowlist": "tsx scripts/generate-allowlist.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "reembed-incidents": "tsx scripts/reembed-incidents.ts",
    "train-dga": "python3 scripts/train_dga.py",
    "train-ip-classifier": "python3 scripts/train_ip_classifier.py"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "resend": "^4.2.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.35",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "eslint": "^9.16.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}
