{
  "name": "guardian",
  "version": "1.0.0",
  "description": "Independent server security monitoring system with AI-powered abuse detection",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "resend": "^4.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.35",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "eslint": "^9.16.0",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
